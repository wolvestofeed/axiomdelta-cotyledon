# Copy to apps/web/.env.local (and repo-root .env for migrations). Never commit filled values.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
ANTHROPIC_API_KEY=sk-ant-...
# Comma-separated sign-in emails granted each role, in addition to the named list in _lib/access.ts
FARM_SUPER_ADMIN_EMAILS=
FARM_OPERATOR_EMAILS=
