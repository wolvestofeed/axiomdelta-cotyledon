# Copy to .env.local (the app) and .env (the migration runner and scripts). Never commit filled values.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
ANTHROPIC_API_KEY=sk-ant-...
# Comma-separated emails that are admins in every farm organization, in addition to the named list in _lib/access.ts

FARM_PLATFORM_ADMIN_EMAILS=
# Local development only: 1 signs every request in as the admin of a local workspace, no Clerk. Ignored in production.
FARM_DEV_BYPASS_AUTH=
# The private preview gate: set a password and the whole deployment sits behind /enter, every visitor who passes it is the
# workspace admin, Clerk is off the door and search engines are asked not to index. Change it to sign everyone out. Empty: no gate.
FARM_PREVIEW_PASSWORD=
# Stripe (the Client Portal's card on file and card payments). Test keys until Rob states live ones; the
# architecture runs with none: the Settings page says billing is not connected and the API routes refuse.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Where Stripe returns the client after Checkout and the billing portal. Default http://localhost:3000.
NEXT_PUBLIC_BASE_URL=
